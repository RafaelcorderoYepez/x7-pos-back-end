{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // TS 6.0 marca `baseUrl` como deprecado y aborta la compilación. El proyecto todavía
    // resuelve por rutas absolutas (`src/...`) en cientos de imports, así que se silencia el
    // aviso hasta que esa migración se haga de verdad; sin esto `npm run build` no arranca.
    "ignoreDeprecations": "6.0",
    "strictPropertyInitialization": false,

    "incremental": false,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": [
      "node",
      "jest"
    ],
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts"
  ]
}
